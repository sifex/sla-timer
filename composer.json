{
    "name": "sifex/sla-timer",
    "description": "A PHP package for calculating & tracking the Service Level Agreement completion timings",
    "keywords": [
        "sifex",
        "sla-timer"
    ],
    "homepage": "https://github.com/sifex/sla-timer",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Alex",
            "email": "alex@sinn.io",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "cmixin/enhanced-period": "^1.2",
        "illuminate/collections": "^11|^12|^13",
        "nesbot/carbon": "^3",
        "spatie/period": "^2"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "pestphp/pest": "^4.7",
        "phpstan/phpstan": "^2",
        "spatie/invade": "^2",
        "spatie/pest-plugin-test-time": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Sifex\\SlaTimer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sifex\\SlaTimer\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage-clover clover.xml"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
